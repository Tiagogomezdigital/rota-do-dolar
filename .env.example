# Exact, comma-separated verified emails allowed in the administrative panel.
ADMIN_EMAILS=

# Vercel runtime. Secrets stay in Vercel environments or ignored local files.
QUIZ_RUNTIME=
VERCEL_CLIENT_ID=
BETTER_AUTH_SECRET=

# Production database; preview and development require their isolated TEST keys.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
QUIZ_TEST_TURSO_DATABASE_URL=
QUIZ_TEST_TURSO_AUTH_TOKEN=
